#!/usr/bin/env bash
# Stand-in for asciiquarium-rs so the cube runs without building the sibling
# project: a few fish swimming at different speeds, full repaint per frame.
size=$(stty size 2>/dev/null) || size=''
rows=${size% *} cols=${size#* }
: "${rows:=39}" "${cols:=78}"
printf '\e[?25l'
trap 'printf "\e[?25h\e[0m"' EXIT
fish='><((*>'
t=0
while :; do
  printf '\e[H\e[2J'
  for i in 0 1 2 3 4 5 6 7; do
    y=$(((i * 5 + 3) % (rows - 2) + 1))
    x=$(((t * (i % 3 + 1) + i * 13) % (cols - ${#fish} - 1) + 1))
    printf '\e[%d;%dH\e[3%dm%s' "$y" "$x" $((i % 6 + 1)) "$fish"
  done
  printf '\e[%d;2H\e[34m%s' "$rows" "~ asciiquarium (stub) ~"
  printf '\e[0m'
  t=$((t + 1))
  sleep 0.15
done
